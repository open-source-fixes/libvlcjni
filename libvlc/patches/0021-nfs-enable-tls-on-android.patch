From a0f2562fdbcecf8c4a58b6e7223a0334b72d865c Mon Sep 17 00:00:00 2001
From: VLC Android NFS Fix <nfs-fix@vlc.local>
Date: Sun, 5 Jul 2026 17:17:06 +0530
Subject: [PATCH 21/21] contrib: nfs: enable TLS/GnuTLS support on Android

libnfs 6.0s CMakeLists.txt restricts TLS (GnuTLS) detection to
CMAKE_SYSTEM_NAME=Linux only.  The VLC contrib toolchain sets
CMAKE_SYSTEM_NAME=Android, so the TLS codepath is silently excluded.
When TLS is compiled out, the RPC event loop handles connection-state
transitions differently, causing async callbacks to either not fire
or fire without completing, preventing NFS directory browsing.

sed 1: Change CMAKE_SYSTEM_NAME check to include Android
sed 2: Replace broken check_include_file with set(HAVE_GNUTLS_H 1)
       since find_package(GnuTLS) already verified the library exists
       and check_include_file uses try_compile which ignores the
       contrib include path when cross-compiling.

Message-Id: <nfs-enable-tls-on-android.vlc-android.fix>

diff --git a/contrib/src/nfs/rules.mak b/contrib/src/nfs/rules.mak
index cd890fb0bd..b3f9c17313 100644
--- a/contrib/src/nfs/rules.mak
+++ b/contrib/src/nfs/rules.mak
@@ -30,6 +30,9 @@ nfs: libnfs-$(NFS_VERSION).tar.gz .sum-nfs
 	$(APPLY) $(SRC)/nfs/0007-tls-add-support-for-kernel-without-TLS_1_3_VERSION.patch
 	$(APPLY) $(SRC)/nfs/0008-tls-define-TLS_RX-if-it-s-missing.patch
 	$(MOVE)
+	# Allow TLS on Android; skip broken check_include_file when cross-compiling
+	sed -i 's/if(CMAKE_SYSTEM_NAME STREQUAL Linux)/if(CMAKE_SYSTEM_NAME STREQUAL Linux OR CMAKE_SYSTEM_NAME STREQUAL Android)/' $@/CMakeLists.txt
+	sed -i '/check_include_file("gnutls\/gnutls.h"/,/endif()/c\    set(HAVE_GNUTLS_H 1)' $@/CMakeLists.txt
 
 .nfs: nfs toolchain.cmake
 	$(CMAKECLEAN)
