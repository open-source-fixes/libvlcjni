From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Message-ID: <nfs-enable-tls-on-android.vlc-android.fix>
From: VLC Android NFS Fix <noreply@example.com>
Date: Sat, 5 Jul 2026 00:00:00 +0000
Subject: [PATCH 21/21] contrib: nfs: enable TLS/GnuTLS support on Android

libnfs 6.0's CMakeLists.txt restricts TLS (GnuTLS) detection to
CMAKE_SYSTEM_NAME=Linux only.  The VLC contrib toolchain sets
CMAKE_SYSTEM_NAME=Android, so the TLS codepath is silently excluded.

With the old autotools build (libnfs 5.x), GnuTLS was detected via
pkg-config regardless of platform name, so TLS was enabled on Android.
When TLS is compiled out of libnfs 6.x, the RPC event loop state
machine in rpc_service() handles connection-state transitions
differently, which causes async callbacks (mount_export_cb, nfs_mount_cb,
nfs_stat64_cb, nfs_opendir_cb) to either not fire or fire without
completing, preventing NFS directory browsing from working.

Add a new contrib patch that fixes libnfs's CMakeLists.txt to also
treat Android as a Linux-like system for TLS/GnuTLS detection, and
update rules.mak to apply it during the libnfs build.

Message-Id: <nfs-enable-tls-on-android.vlc-android.fix>
---
 contrib/src/nfs/0009-tls-allow-on-android.patch | 21 +++++++++++++++++++++
 contrib/src/nfs/rules.mak                       |  1 +
 2 files changed, 22 insertions(+)
 create mode 100644 contrib/src/nfs/0009-tls-allow-on-android.patch

diff --git a/contrib/src/nfs/0009-tls-allow-on-android.patch b/contrib/src/nfs/0009-tls-allow-on-android.patch
new file mode 100644
index 0000000000..08e0ee4caf
--- /dev/null
+++ b/contrib/src/nfs/0009-tls-allow-on-android.patch
@@ -0,0 +1,21 @@
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -68,7 +68,7 @@ if(ENABLE_MULTITHREADING AND PTHREAD_LIBRARY)
+     list(APPEND SYSTEM_LIBRARIES pthread)
+ endif()
+
+-if(CMAKE_SYSTEM_NAME STREQUAL Linux)
++if(CMAKE_SYSTEM_NAME STREQUAL Linux OR CMAKE_SYSTEM_NAME STREQUAL Android)
+   add_definitions("-D_U_=__attribute__((unused))")
+   #
+   # Currently RPC-with-TLS support is only available on Linux since it
+   # depends on kTLS support on Linux.  Android uses the Linux kernel
+   # and may have kTLS available.
+   #
+   # TODO: BSD also has kTLS support, but that will need separate validation.
+   #
+   find_package(GnuTLS "3.4.6")
+   if(GNUTLS_FOUND)
+     check_include_file("gnutls/gnutls.h" HAVE_GNUTLS_H)
+     if(NOT HAVE_GNUTLS_H EQUAL "1")
+       message(FATAL_ERROR "GnuTLS found but gnutls/gnutls.h not found")
+     endif()
+     add_definitions(-DHAVE_TLS)
+     list(APPEND SYSTEM_LIBRARIES ${GNUTLS_LIBRARIES})
+     add_subdirectory(tls)
+   endif()
+ endif()
diff --git a/contrib/src/nfs/rules.mak b/contrib/src/nfs/rules.mak
index cd890fb0bd..f9338adac5 100644
--- a/contrib/src/nfs/rules.mak
+++ b/contrib/src/nfs/rules.mak
@@ -29,6 +29,7 @@ nfs: libnfs-$(NFS_VERSION).tar.gz .sum-nfs
 	$(APPLY) $(SRC)/nfs/0001-cmake-export-the-necessary-library-in-the-pkg-config.patch
 	$(APPLY) $(SRC)/nfs/0007-tls-add-support-for-kernel-without-TLS_1_3_VERSION.patch
 	$(APPLY) $(SRC)/nfs/0008-tls-define-TLS_RX-if-it-s-missing.patch
+	$(APPLY) $(SRC)/nfs/0009-tls-allow-on-android.patch
 	$(MOVE)

 .nfs: nfs toolchain.cmake
